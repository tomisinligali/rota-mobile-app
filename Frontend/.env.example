# ==============================================================================
# ROTA MOBILE APP - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS ON HOW TO CHANGE THE IP:
# 1. Find your machine's local IPv4 address by running in terminal:
#    macOS: ipconfig getifaddr en0 (or en1 for Wi-Fi)
#    Linux: hostname -I
#    Windows: ipconfig (look for IPv4 Address)
# 2. Replace the IP address below (e.g. 192.168.100.33) with your actual LAN IP.
# 3. Ensure your mobile device or simulator is connected to the exact same Wi-Fi network.
# 4. Restart the Expo server with: npx expo start -c
# ==============================================================================

EXPO_PUBLIC_API_URL=http://192.168.100.33:5001/api/v1
API_URL=http://192.168.100.33:5001/api/v1
