# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://mac@localhost:5432/rota_dev

# Authentication & Session Secrets (Change in production)
JWT_SECRET=rota-dev-jwt-secret-key-replace-in-production-random-bytes-min-32-chars

# Google Sign-In (OAuth) — Web client ID used to verify Google ID tokens
GOOGLE_CLIENT_ID=

# Email delivery (Nodemailer over Gmail SMTP for development)
# SMTP_PASS must be a Google App Password (https://myaccount.google.com/apppasswords),
# never your normal Gmail password. SMTP_SECURE=true is correct for port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Public base URL used to build the email-verification link. Use your Mac's LAN
# IP (not localhost) so the link opens from a phone on the same Wi-Fi.
APP_BASE_URL=http://192.168.100.33:5001
